[Unit]
Description=Restore Kubernetes The Hard Way /etc/hosts entries
# cloud-init rewrites /etc/hosts from a template on every boot (manage_etc_hosts),
# dropping the lab's entries. Ordering after the last cloud-init stage means we put
# them back once it has finished, rather than racing it.
After=cloud-final.service
Wants=cloud-final.service
Before=multi-user.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/kthw-hosts.sh

[Install]
WantedBy=multi-user.target
